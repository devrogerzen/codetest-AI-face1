# Copiá este archivo como .env y completá tus keys (el .env NO se sube a GitHub)

# Proveedor por defecto: openai | anthropic
LLM_PROVIDER=openai

OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Opcionales (si no se definen se usan estos valores)
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-haiku-4-5
